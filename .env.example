# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emotional_climate?schema=public"

# API Server
PORT=3001
NODE_ENV=development

# AI Provider
OPENAI_API_KEY=sk-...
# Or use AI_PROVIDER_KEY for generic provider
AI_PROVIDER=openai
# Options: openai, stub

# Cors
CORS_ORIGIN=http://localhost:3000

# Snapshot Configuration
SNAPSHOT_WINDOW_HOURS=24
