// Prisma schema for Emotional Climate Sensing Service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Represents a source of signals (chat platform, forum, survey tool, etc.)
model SignalSource {
  id          String   @id @default(cuid())
  key         String   @unique // Unique identifier for API validation
  name        String
  description String?
  sourceType  SourceType
  metaJson    Json?    @db.JsonB // Additional metadata (API keys, webhook URLs, etc.)
  createdAt   DateTime @default(now())

  rawSignals  RawSignal[]

  @@map("signal_sources")
}

enum SourceType {
  chat
  forum
  survey
  other
}

// Raw text signal ingested from a source
model RawSignal {
  id                String   @id @default(cuid())
  sourceId          String
  communityId       String   // Logical grouping (team, channel, organization)
  externalMessageId String?  // Original ID from the source system
  authorRef         String?  // Reference to author (email, username, user_id)
  text              String   @db.Text
  ts                DateTime // Timestamp when signal was created/posted
  metaJson          Json?    @db.JsonB // Additional metadata
  createdAt         DateTime @default(now())

  source            SignalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  emotionalAnalysis EmotionalAnalysis?

  @@index([communityId, ts])
  @@index([sourceId])
  @@map("raw_signals")
}

// AI-generated emotional analysis of a raw signal
model EmotionalAnalysis {
  id              String   @id @default(cuid())
  rawSignalId     String   @unique
  sentimentScore  Float    // -1 (very negative) to +1 (very positive)
  emotionsJson    Json     @db.JsonB // Array of emotion labels with weights, e.g. [{"emotion": "joy", "weight": 0.8}, ...]
  intensityScore  Float    // 0 (mild) to 1 (intense)
  aiModelInfoJson Json?    @db.JsonB // Model name, version, provider, etc.
  createdAt       DateTime @default(now())

  rawSignal       RawSignal @relation(fields: [rawSignalId], references: [id], onDelete: Cascade)

  @@index([rawSignalId])
  @@map("emotional_analyses")
}

// Aggregated emotional climate snapshot for a community over a time window
model ClimateSnapshot {
  id                  String   @id @default(cuid())
  communityId         String
  windowStart         DateTime
  windowEnd           DateTime
  aggregateSentiment  Float    // Average sentiment across all signals in window
  dominantEmotionsJson Json    @db.JsonB // Top emotions with frequencies
  summaryMarkdown     String   @db.Text // Human-readable summary generated by AI
  signalCount         Int      @default(0)
  createdAt           DateTime @default(now())

  community           CommunityProfile? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, windowEnd])
  @@map("climate_snapshots")
}

// Community profile with configuration and preferences
model CommunityProfile {
  id                String   @id @default(cuid())
  name              String
  description       String?
  timezone          String   @default("UTC")
  tags              String[] // Tags for categorization
  settingsJson      Json?    @db.JsonB // Custom settings (analysis parameters, thresholds)
  status            CommunityStatus @default(active)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  snapshots         ClimateSnapshot[]
  alertRules        AlertRule[]
  analyticsSummaries AnalyticsSummary[]
  eventLogs         EventLog[]

  @@map("community_profiles")
}

enum CommunityStatus {
  active
  archived
  suspended
}

// Alert rules for automated climate monitoring
model AlertRule {
  id                String   @id @default(cuid())
  communityId       String
  name              String
  description       String?
  conditionType     AlertConditionType
  threshold         Float    // Threshold value for the condition
  windowSize        Int      @default(1) // Number of snapshots to evaluate
  actionsJson       Json     @db.JsonB // Actions to take when triggered (notify, webhook, etc.)
  enabled           Boolean  @default(true)
  lastTriggeredAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  community         CommunityProfile @relation(fields: [communityId], references: [id], onDelete: Cascade)
  triggeredAlerts   TriggeredAlert[]

  @@index([communityId, enabled])
  @@map("alert_rules")
}

enum AlertConditionType {
  sentiment_below
  sentiment_above
  sentiment_drop
  sentiment_spike
  emotion_dominant
  signal_volume_low
  signal_volume_high
}

// Record of triggered alerts
model TriggeredAlert {
  id              String   @id @default(cuid())
  ruleId          String
  communityId     String
  severity        AlertSeverity
  message         String
  detailsJson     Json?    @db.JsonB // Snapshot data, thresholds, etc.
  status          AlertStatus @default(pending)
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())

  rule            AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([communityId, status, createdAt])
  @@index([ruleId])
  @@map("triggered_alerts")
}

enum AlertSeverity {
  info
  warning
  critical
}

enum AlertStatus {
  pending
  acknowledged
  resolved
  dismissed
}

// Pre-computed analytics summaries for fast queries
model AnalyticsSummary {
  id              String   @id @default(cuid())
  communityId     String
  periodType      PeriodType
  periodStart     DateTime
  periodEnd       DateTime
  statsJson       Json     @db.JsonB // Aggregated statistics
  createdAt       DateTime @default(now())

  community       CommunityProfile @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, periodType, periodStart])
  @@index([communityId, periodType, periodStart])
  @@map("analytics_summaries")
}

enum PeriodType {
  daily
  weekly
  monthly
  quarterly
  yearly
}

// Event log for tracking significant occurrences
model EventLog {
  id              String   @id @default(cuid())
  communityId     String
  eventType       EventType
  severity        EventSeverity @default(info)
  title           String
  description     String?
  metadataJson    Json?    @db.JsonB
  userId          String?  // User who triggered the event (if applicable)
  createdAt       DateTime @default(now())

  community       CommunityProfile @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, eventType, createdAt])
  @@map("event_logs")
}

enum EventType {
  snapshot_created
  alert_triggered
  climate_shift
  intervention_started
  intervention_completed
  configuration_changed
  analysis_batch_completed
  data_export
  system_event
}

enum EventSeverity {
  debug
  info
  warning
  error
  critical
}

// Integration configurations for external services
model IntegrationConfig {
  id                String   @id @default(cuid())
  name              String
  integrationType   IntegrationType
  configJson        Json     @db.JsonB // API keys, webhook URLs, etc. (encrypted)
  enabled           Boolean  @default(true)
  lastUsedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("integration_configs")
}

enum IntegrationType {
  slack
  discord
  email
  webhook
  teams
  custom
}
