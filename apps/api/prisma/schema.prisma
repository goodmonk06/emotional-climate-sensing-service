// Prisma schema for Emotional Climate Sensing Service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Represents a source of signals (chat platform, forum, survey tool, etc.)
model SignalSource {
  id          String   @id @default(cuid())
  key         String   @unique // Unique identifier for API validation
  name        String
  description String?
  sourceType  SourceType
  metaJson    Json?    @db.JsonB // Additional metadata (API keys, webhook URLs, etc.)
  createdAt   DateTime @default(now())

  rawSignals  RawSignal[]

  @@map("signal_sources")
}

enum SourceType {
  chat
  forum
  survey
  other
}

// Raw text signal ingested from a source
model RawSignal {
  id                String   @id @default(cuid())
  sourceId          String
  communityId       String   // Logical grouping (team, channel, organization)
  externalMessageId String?  // Original ID from the source system
  authorRef         String?  // Reference to author (email, username, user_id)
  text              String   @db.Text
  ts                DateTime // Timestamp when signal was created/posted
  metaJson          Json?    @db.JsonB // Additional metadata
  createdAt         DateTime @default(now())

  source            SignalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  emotionalAnalysis EmotionalAnalysis?

  @@index([communityId, ts])
  @@index([sourceId])
  @@map("raw_signals")
}

// AI-generated emotional analysis of a raw signal
model EmotionalAnalysis {
  id              String   @id @default(cuid())
  rawSignalId     String   @unique
  sentimentScore  Float    // -1 (very negative) to +1 (very positive)
  emotionsJson    Json     @db.JsonB // Array of emotion labels with weights, e.g. [{"emotion": "joy", "weight": 0.8}, ...]
  intensityScore  Float    // 0 (mild) to 1 (intense)
  aiModelInfoJson Json?    @db.JsonB // Model name, version, provider, etc.
  createdAt       DateTime @default(now())

  rawSignal       RawSignal @relation(fields: [rawSignalId], references: [id], onDelete: Cascade)

  @@index([rawSignalId])
  @@map("emotional_analyses")
}

// Aggregated emotional climate snapshot for a community over a time window
model ClimateSnapshot {
  id                  String   @id @default(cuid())
  communityId         String
  windowStart         DateTime
  windowEnd           DateTime
  aggregateSentiment  Float    // Average sentiment across all signals in window
  dominantEmotionsJson Json    @db.JsonB // Top emotions with frequencies
  summaryMarkdown     String   @db.Text // Human-readable summary generated by AI
  createdAt           DateTime @default(now())

  @@index([communityId, windowEnd])
  @@map("climate_snapshots")
}
